# Firebase web config (client)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server only: service account JSON, base64-encoded (base64 -w0 key.json)
FIREBASE_SERVICE_ACCOUNT_B64=

# Zeffy webhook: set the webhook URL in Zeffy to
#   https://YOUR-APP/api/zeffy/webhook?token=<this value>
ZEFFY_WEBHOOK_TOKEN=
