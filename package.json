{
  "name": "dices-checkin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/passes.test.ts test/zeffy.test.ts",
    "test:rules": "firebase emulators:exec --only firestore --project demo-dices-checkin \"tsx --tsconfig tsconfig.json --test --test-concurrency=1 test/rules.test.ts test/webhook.test.ts\"",
    "seed-admin": "tsx --env-file=.env.local scripts/seed-admin.ts"
  },
  "dependencies": {
    "firebase": "^11.0.0",
    "firebase-admin": "^13.0.0",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
